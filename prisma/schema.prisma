generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  OPERARIO
  ADMINISTRACION
  MANAGER
  ADMIN
}

enum SackStatus {
  PENDIENTE_RECIBIR
  EN_ALMACEN
  EN_PRODUCCION
  PROCESADA
  PRODUCTO_TERMINADO
  SUBPRODUCTO
  RECHAZO
  EN_TRANSITO
  ENTREGADA
  BAJA
}

enum MaterialType {
  PELLET_PE
  PELLET_PP
  PELLET_PET
  FILM_PE
  FILM_PP
  RIGIDO_MIXTO
  OTRO
}

// GL-53: naturaleza de un tipo de material — determina en qué parte del flujo
// se usa (materia prima en recepción; PT/Subproducto/Rechazo en producción).
enum MaterialKind {
  MATERIA_PRIMA
  PRODUCTO_TERMINADO
  SUBPRODUCTO
  RECHAZO
  OTRO
}

enum LotType {
  PRODUCTO_TERMINADO
  SUBPRODUCTO
  RECHAZO
}

enum ShipmentStatus {
  BORRADOR
  CONFIRMADO
  EXPEDIDO
  ENTREGADO
}

enum IncidentStatus {
  ABIERTA
  EN_REVISION
  EN_PROCESO
  RESUELTA
  CERRADA
}

enum PurchaseOrderStatus {
  ABIERTA
  EN_TRANSITO
  RECIBIDA_PARCIAL
  COMPLETADA
  CANCELADA
}

enum ConsumableType {
  PALLET
  SACA_VACIA
  CAPUCHON
  OTRO
}

enum QualityResult {
  OK
  NOK
  PENDIENTE
}

// ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String    // bcrypt hash — sin SSO
  role          UserRole  @default(OPERARIO)
  active        Boolean   @default(true)

  accounts      Account[]
  sessions      Session[]
  incidents     Incident[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Proveedores y compradores ─────────────────────────────────────────────────

model Supplier {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  country   String  @default("ES")
  active    Boolean @default(true)
  notes     String?

  containers Container[]
  purchaseOrders PurchaseOrder[]
  qualityRecords QualityRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

model Buyer {
  id      String  @id @default(cuid())
  name    String
  code    String  @unique
  country String  @default("ES")
  active  Boolean @default(true)
  notes   String?

  holdedId String? // ID en Holded para generar albaranes

  shipments Shipment[]
  palletMovements PalletMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buyers")
}

model Carrier {
  id       String  @id @default(cuid())
  name     String
  holdedId String? // GL-54: ID del transportista en Holded
  active   Boolean @default(true)

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carriers")
}

// ─── Almacenes y zonas ─────────────────────────────────────────────────────────

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  location String? // dirección / planta
  active   Boolean @default(true)

  zones      Zone[]
  containers Container[] // contenedores con este almacén como destino declarado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

model Zone {
  id           String  @id @default(cuid())
  name         String
  code         String
  maxCapacity  Int     // máximo de sacas
  warehouseId  String

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  sacks     Sack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, warehouseId])
  @@index([warehouseId])
  @@map("zones")
}

// ─── Materiales ────────────────────────────────────────────────────────────────

model Material {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  type        MaterialType
  description String?
  active      Boolean      @default(true)

  // GL-53: tipo/categoría configurable (Materia Prima, PT, Subproducto, Rechazo…).
  categoryId String?
  category   MaterialCategory? @relation(fields: [categoryId], references: [id])

  sacks          Sack[]
  productionLots ProductionLot[]
  qualityRecords QualityRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("materials")
}

// GL-53: tipos de material configurables (se pueden crear/desactivar).
model MaterialCategory {
  id     String       @id @default(cuid())
  name   String
  kind   MaterialKind @default(OTRO)
  active Boolean      @default(true)

  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("material_categories")
}

// ─── Contenedores / Camiones ───────────────────────────────────────────────────

model Container {
  id              String  @id @default(cuid())
  reference       String  @unique // nº contenedor o matrícula camión
  billOfLading    String? // para envíos marítimos
  supplierId      String
  materialId      String?
  expectedWeight  Float?  // kg estimados
  actualWeight    Float?  // kg pesados en Gestruck (peso NETO)
  grossWeight     Float?  // kg peso bruto real (camión cargado)
  tareWeight      Float?  // kg tara real (camión vacío)
  sackType        String? // tipo de saca: sacas_altas | sacas_bajas | saquitos | balas
  numSacks        Int?    // nº sacas declaradas
  numPallets      Int?    @default(0)
  notes           String?

  // Fechas de tracking
  estimatedArrival DateTime?
  arrivedAt        DateTime?
  registeredAt     DateTime?

  // Pesaje
  weighedAt    DateTime?
  weightSource String?  @default("gestruck") // "gestruck" | "manual"
  scaleId      String?  // ID de báscula Gestruck

  // Almacén destino declarado al registrar (antes de pesar). Permite proyectar
  // la ocupación por almacén con las sacas entrantes aún no recibidas.
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])

  supplierId2  String? // alias para supplier
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  sacks        Sack[]

  providerShipmentId String?
  providerShipment   ProviderShipment? @relation(fields: [providerShipmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([providerShipmentId])
  @@map("containers")
}

// ─── Sacas (Big Bags) — entidad central ───────────────────────────────────────

model Sack {
  id          String     @id @default(cuid())
  qrCode      String     @unique // QR impreso en etiqueta
  status      SackStatus @default(EN_ALMACEN)
  weight      Float      // kg
  materialId  String
  zoneId      String?
  containerId String?
  lotId       String?    // lote de producción (si es PT/Subproducto/Rechazo)

  material  Material  @relation(fields: [materialId], references: [id])
  zone      Zone?     @relation(fields: [zoneId], references: [id])
  container Container? @relation(fields: [containerId], references: [id])
  lot       ProductionLot? @relation(fields: [lotId], references: [id])

  transformationInputs  TransformationInput[]
  shipmentSacks         ShipmentSack[]

  // Trazabilidad de salida (GL-37): si es saca de salida (PT/Sub/Rechazo),
  // `composedOf` son las sacas de entrada que la conformaron; si es saca de
  // entrada (tolva), `consumedBy` son las salidas a las que contribuyó.
  composedOf OutputSackInput[] @relation("SackComposition")
  consumedBy OutputSackInput[] @relation("SackConsumedBy")

  notes       String?
  batchNumber String? // nº saca dentro del contenedor (ej: 1/50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([zoneId])
  @@index([containerId])
  @@index([materialId])
  @@index([lotId])
  @@map("sacks")
}

// ─── Producción — Lotes y Transformaciones ─────────────────────────────────────

model ProductionLot {
  id         String    @id @default(cuid())
  lotNumber  String    @unique // DDMMYY-nºcamión — autogenerado
  type       LotType
  materialId String
  producedAt DateTime  @default(now())
  notes      String?

  // GL-36: lotes de 22 sacas. Un lote acumula sacas de salida mientras está
  // abierto; al llegar a 22 se cierra (isOpen=false) y queda "listo para enviar".
  isOpen   Boolean   @default(true)
  closedAt DateTime?

  material        Material         @relation(fields: [materialId], references: [id])
  sacks           Sack[]           // sacas de output (PT/Sub/Rechazo)
  transformations Transformation[]
  qualityRecords  QualityRecord[]
  shipmentLots    ShipmentLot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([producedAt])
  @@index([materialId])
  @@map("production_lots")
}

model Transformation {
  id        String   @id @default(cuid())
  lotId     String
  operatorId String?
  startedAt DateTime @default(now())
  endedAt   DateTime?
  notes     String?

  lot    ProductionLot         @relation(fields: [lotId], references: [id])
  inputs TransformationInput[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lotId])
  @@map("transformations")
}

model TransformationInput {
  id               String @id @default(cuid())
  transformationId String
  sackId           String

  transformation Transformation @relation(fields: [transformationId], references: [id])
  sack           Sack           @relation(fields: [sackId], references: [id])

  enteredAt DateTime @default(now())

  @@index([transformationId])
  @@index([sackId])
  @@map("transformation_inputs")
}

// Trazabilidad saca de salida → sacas de entrada (GL-37).
// Cada saca de salida (PT/Subproducto/Rechazo) registra qué sacas de la tolva
// la conformaron. El acumulador por tipo se deriva: los inputs de la
// transformación abierta que aún no están ligados a una salida de ese tipo.
model OutputSackInput {
  id           String @id @default(cuid())
  outputSackId String // saca de salida (PT/Sub/Rechazo)
  inputSackId  String // saca de entrada (tolva) que la conformó

  outputSack Sack @relation("SackComposition", fields: [outputSackId], references: [id], onDelete: Cascade)
  inputSack  Sack @relation("SackConsumedBy", fields: [inputSackId], references: [id])

  createdAt DateTime @default(now())

  @@unique([outputSackId, inputSackId])
  @@index([outputSackId])
  @@index([inputSackId])
  @@map("output_sack_inputs")
}

// ─── Expediciones ─────────────────────────────────────────────────────────────

model Shipment {
  id          String         @id @default(cuid())
  reference   String         @unique // autogenerado
  status      ShipmentStatus @default(BORRADOR)
  buyerId     String
  carrierId   String?
  vehiclePlate String?
  driverName  String?
  notes       String?

  scheduledAt     DateTime? // GL-42: fecha programada de expedición
  holdedAlbaranId String? // ID albarán en Holded (generado al confirmar)
  expeditedAt     DateTime?
  deliveredAt     DateTime?

  buyer    Buyer    @relation(fields: [buyerId], references: [id])
  carrier  Carrier? @relation(fields: [carrierId], references: [id])
  lots     ShipmentLot[]
  sacks    ShipmentSack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([buyerId])
  @@index([carrierId])
  @@map("shipments")
}

model ShipmentLot {
  id         String @id @default(cuid())
  shipmentId String
  lotId      String
  weightKg   Float

  shipment Shipment      @relation(fields: [shipmentId], references: [id])
  lot      ProductionLot @relation(fields: [lotId], references: [id])

  @@index([shipmentId])
  @@index([lotId])
  @@map("shipment_lots")
}

model ShipmentSack {
  id         String @id @default(cuid())
  shipmentId String
  sackId     String

  shipment Shipment @relation(fields: [shipmentId], references: [id])
  sack     Sack     @relation(fields: [sackId], references: [id])

  @@index([shipmentId])
  @@index([sackId])
  @@map("shipment_sacks")
}

// ─── Aprovisionamiento (Transporte / POs) ──────────────────────────────────────

model PurchaseOrder {
  id         String              @id @default(cuid())
  poNumber   String              @unique
  supplierId String
  materialId String?
  status     PurchaseOrderStatus @default(ABIERTA)
  orderedTons Float
  originPort  String? // puerto o país de origen del pedido
  totalPrice  Float?  // precio total del pedido (€)
  pricePerTon Float?  // €/tonelada de compra — base del coste por tonelada del lote final (= totalPrice / orderedTons)
  notes      String?

  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  providerShipments ProviderShipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model ProviderShipment {
  id              String   @id @default(cuid())
  purchaseOrderId String?
  billOfLading    String?  @unique
  origin          String?  // puerto origen
  vessel          String?  // nombre del barco
  departureDate   DateTime? // fecha de salida de origen
  maritimeDays    Int?     @default(30) // días de tránsito marítimo
  terrestrialDays Int?     @default(7)  // días de tránsito terrestre (Valencia → planta)
  etaValencia     DateTime?
  etaPlanta       DateTime?
  arrivedValencia DateTime?
  arrivedPlanta   DateTime?
  weightKg        Float?
  notes           String?

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  containers    Container[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@map("provider_shipments")
}

// ─── Calidad ──────────────────────────────────────────────────────────────────

model QualityRecord {
  id         String        @id @default(cuid())
  // lot/material son opcionales: el editor tipo hoja de calidad crea registros
  // diarios por fecha/turno/cliente que no cuelgan de un lote de producción.
  lotId      String?
  materialId String?
  supplierId String?
  shift      String?       // turno: Mañana/Tarde/Noche
  sampleType String?       // tipo de muestra: MP/PT (provisional, pendiente confirmar con Paula)
  result     QualityResult @default(PENDIENTE)
  overrideReason String?   // motivo si se override NOK→OK

  // Datos de cabecera del registro diario (estilo prototipo)
  date       DateTime?     // fecha del registro de calidad
  client     String?       // cliente asociado (texto libre)

  // Promedios agregados del registro (compat. anterior; el detalle vive en samples)
  density    Float?
  pvcPct     Float?
  gluePct    Float?
  multilayerPct Float?
  metalPct   Float?
  otherPct   Float?
  notes      String?

  lot      ProductionLot? @relation(fields: [lotId], references: [id])
  material Material?      @relation(fields: [materialId], references: [id])
  supplier Supplier?      @relation(fields: [supplierId], references: [id])
  samples  QualitySample[]

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([lotId])
  @@index([materialId])
  @@index([supplierId])
  @@index([recordedAt])
  @@index([date])
  @@map("quality_records")
}

// Muestra individual dentro de un registro de calidad (rejilla tipo Excel:
// hasta 20 muestras por registro, cada una con densidad + porcentajes de
// contaminantes, estado OK/NOK/PENDIENTE y comentario).
model QualitySample {
  id       String @id @default(cuid())
  recordId String
  index    Int    // 1..20, posición en la rejilla

  density    Float?
  pvc        Float?
  cola       Float?
  multicapas Float?
  metal      Float?
  otros      Float?

  status  String? // OK / NOK / PENDIENTE (auto por rango de densidad)
  comment String?

  record QualityRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("quality_samples")
}

// ─── Consumibles ──────────────────────────────────────────────────────────────

model Consumable {
  id           String         @id @default(cuid())
  type         ConsumableType
  name         String
  currentStock Int            @default(0)
  minStock     Int            @default(0) // umbral de alerta
  unit         String         @default("ud")

  movements ConsumableMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consumables")
}

model ConsumableMovement {
  id           String @id @default(cuid())
  consumableId String
  quantity     Int    // positivo = entrada, negativo = salida
  reason       String // "compra", "expedición", "devolución", "ajuste"
  unitPrice    Float? // precio por unidad de esa compra (€/ud); solo en entradas
  vehiclePlate String?
  condition    String? // "OK" | "NOK" para devoluciones
  notes        String?

  consumable Consumable @relation(fields: [consumableId], references: [id])
  createdAt  DateTime   @default(now())

  @@index([consumableId])
  @@map("consumable_movements")
}

// ─── Pallets retornables (por cliente) ────────────────────────────────────────

model PalletMovement {
  id           String   @id @default(cuid())
  buyerId      String
  quantity     Int      // positivo = préstamo, negativo = devolución
  condition    String?  // "OK" | "NOK"
  vehiclePlate String?  // matrícula del camión (devoluciones)
  shipmentId   String?
  notes        String?

  buyer     Buyer    @relation(fields: [buyerId], references: [id])
  createdAt DateTime @default(now())

  @@index([buyerId])
  @@index([shipmentId])
  @@map("pallet_movements")
}

// ─── Incidencias ──────────────────────────────────────────────────────────────

model Incident {
  id          String         @id @default(cuid())
  status      IncidentStatus @default(ABIERTA)
  title       String
  description String?
  warehouseId String?
  sackQrCode  String?        // QR de saca relacionada
  photoUrl    String?        // Cloudflare R2
  reportedById String

  reportedBy User   @relation(fields: [reportedById], references: [id])
  resolvedAt DateTime?
  closedAt   DateTime?

  notes IncidentNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("incidents")
}

// GL-56: nota/comentario en cada cambio de estado de una incidencia.
model IncidentNote {
  id         String          @id @default(cuid())
  incidentId String
  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String?
  note       String
  fromStatus IncidentStatus?
  toStatus   IncidentStatus?

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@map("incident_notes")
}

// ─── Configuración (clave/valor) ───────────────────────────────────────────────

// Tabla clave/valor para configuración de negocio (rangos de calidad, costes…).
// Regla del proyecto: no hardcodear valores de negocio, viven en `config`.
model Config {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("config")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "CREATE_SACK", "CONFIRM_SHIPMENT", etc.
  entity     String   // "Sack", "Shipment", etc.
  entityId   String?
  payload    Json?    // diff o datos relevantes
  ip         String?

  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}
